# Secrets and local config: never commit
.env
certs/

# Obsidian app state for the demo vault.
# plugins/obsidian-local-rest-api/data.json holds the API key and the TLS private key.
demo-vault/.obsidian/
# Plans the agent writes during runs are output, not source.
demo-vault/Плани/*.md
# Local copy of a plan when Obsidian was unreachable at write time
out/

# Raw downloads for scripts/build_dataset.py (re-creatable; the built data/routes.json is committed)
data/raw/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Local state (e.g. "OpenRouter quota used up until ...")
.cache/
