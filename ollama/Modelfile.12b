# Variant for machines with 24 GB+ memory: Gemma 4 12B (better, but on a 16 GB Mac it swaps and takes minutes).
#   ollama pull gemma4:12b
#   ollama create plast-gemma -f ollama/Modelfile.12b
# num_ctx: Ollama's default context here is 4096 and longer prompts are cut silently from the start
# (system prompt included); the agent's prompts need up to ~6000 tokens.
FROM gemma4:12b
PARAMETER num_ctx 8192
PARAMETER temperature 0
# at most 900 tokens per answer: a runaway answer stops in seconds, not after a 3-minute timeout
PARAMETER num_predict 900
