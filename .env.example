# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Model (OpenRouter) -------------------------------------------------
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Obsidian MCP (plugin "Local REST API with MCP") --------------------
# API key: Obsidian -> Settings -> Local REST API -> API Key
OBSIDIAN_API_KEY=
OBSIDIAN_MCP_URL=https://127.0.0.1:27124/mcp/
# The plugin uses its own self-signed certificate. Download it once with:
#   curl -sk https://127.0.0.1:27124/obsidian-local-rest-api.crt -o certs/obsidian-local-rest-api.crt
OBSIDIAN_CA_CERT=certs/obsidian-local-rest-api.crt

# --- Custom MCP server "plast-trail" ------------------------------------
PLAST_TRAIL_HOST=127.0.0.1
PLAST_TRAIL_PORT=8770
# live = call Open-Meteo; replay = read recorded responses from fixtures/
WEATHER_MODE=replay

# --- Local fallback model (Ollama) ----------------------------------------
# Used automatically when OpenRouter's free quota is used up (HTTP 429), times out or is unreachable.
#   ollama pull gemma4:12b && ollama create plast-gemma -f ollama/Modelfile
OLLAMA_FALLBACK=1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=plast-gemma
